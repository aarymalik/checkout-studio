# Checkout Studio — local environment
#
# Copy to .env.local and fill in. Every variable here is validated at startup by
# each app's src/env.ts; a missing or malformed value fails fast with a precise
# message. Never commit a filled-in copy. See docs/contributing.md.

NODE_ENV=development
APP_URL=http://localhost:3000
# Set by the deployment pipeline in staging and production.
APP_VERSION=0.0.0

# Infrastructure (Phase 2)
DATABASE_URL=postgresql://USER@localhost:5432/checkout_studio
REDIS_URL=redis://localhost:6379

# Integration tests use their own databases, so a test run can never destroy
# development work:
#   createdb checkout_studio_test_database
#   createdb checkout_studio_test_api

# Integration tests use their own databases so a test run can never destroy
# development work. Created by: createdb checkout_studio_test_database
#                               createdb checkout_studio_test_api

# Authentication — Clerk development instance (Phase 2, Studio only)
CLERK_SECRET_KEY=sk_test_replaceme
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replaceme

# Payments — Stripe TEST MODE ONLY.
# A live secret key (sk_live_…) outside production is rejected at startup.
STRIPE_SECRET_KEY=sk_test_replaceme
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replaceme
# From `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replaceme
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe-billing`
STRIPE_WEBHOOK_SECRET_BILLING=whsec_replaceme

# Storage (Phase 14)
UPLOADTHING_SECRET=ut_replaceme
UPLOADTHING_APP_ID=ut_replaceme
