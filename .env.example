# Checkout Studio — local environment
#
# Copy to .env.local and fill in. Every variable here is validated at startup by
# each app's src/env.ts; a missing or malformed value fails fast with a precise
# message. Never commit a filled-in copy. See docs/contributing.md.

NODE_ENV=development
APP_URL=http://localhost:3000
# Set by the deployment pipeline in staging and production.
APP_VERSION=0.0.0

# Infrastructure (Phase 2)
DATABASE_URL=postgresql://USER@localhost:5432/checkout_studio
REDIS_URL=redis://localhost:6379

# Integration tests use their own databases, so a test run can never destroy
# development work:
#   createdb checkout_studio_test_database
#   createdb checkout_studio_test_api

# Integration tests use their own databases so a test run can never destroy
# development work. Created by: createdb checkout_studio_test_database
#                               createdb checkout_studio_test_api

# Authentication — ours. Any long random string will do locally; each
# environment generates its own. See docs/security.md.
AUTH_SESSION_SECRET=replaceme-with-at-least-32-bytes-of-randomness

# Transactional email — verification and password reset only. Without a real
# key, messages are written to the log instead of sent.
RESEND_API_KEY=re_test_replaceme
EMAIL_FROM=noreply@example.test

# Payments — Stripe TEST MODE ONLY.
# A live secret key (sk_live_…) outside production is rejected at startup.
STRIPE_SECRET_KEY=sk_test_replaceme
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replaceme
# From `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replaceme
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe-billing`
STRIPE_WEBHOOK_SECRET_BILLING=whsec_replaceme

# Object storage, over the S3 API — which is not a choice of vendor. These
# point at MinIO or Garage on a machine you run just as readily as at a hosted
# bucket. The endpoint carries no bucket: the bucket goes in the path.
#
#   docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address :9001
#
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=checkout-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# What a browser fetches an asset from. The bucket itself, locally.
ASSET_BASE_URL=http://localhost:9000/checkout-assets
