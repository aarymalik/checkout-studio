{
  "name": "@checkout-studio/design-system",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./css/variables.css": "./src/css/variables.css",
    "./css/reset.css": "./src/css/reset.css",
    "./tailwind/tokens.css": "./src/tailwind/tokens.css"
  },
  "scripts": {
