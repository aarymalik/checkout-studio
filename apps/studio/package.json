{
  "name": "@checkout-studio/studio",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "clean": "rm -rf .next coverage playwright-report .turbo",
    "bench:canvas": "playwright test --config playwright.bench.config.ts"
  },
  "dependencies": {
    "@checkout-studio/api": "workspace:*",
    "@checkout-studio/cache": "workspace:*",
    "@checkout-studio/database": "workspace:*",
    "@checkout-studio/design-system": "workspace:*",
    "@checkout-studio/editor": "workspace:*",
    "@checkout-studio/hooks": "workspace:*",
    "@checkout-studio/observability": "workspace:*",
    "@checkout-studio/plugin-sdk": "workspace:*",
    "@checkout-studio/renderer": "workspace:*",
    "@checkout-studio/schema": "workspace:*",
    "@checkout-studio/types": "workspace:*",
    "@checkout-studio/ui": "workspace:*",
    "@checkout-studio/utils": "workspace:*",
    "lucide-react": "0.552.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@checkout-studio/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.11.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
